        {
          "type": "dialogue",
          "speaker": "진이현",
          "text": "예전 같으면 이 순간을 되돌렸을 겁니다.",
          "portrait": "smile"
        },
        {
          "type": "narration",
          "text": "그는 잘못 말한 문장을 그대로 두고 조금 어색하게 웃었다."
        }
      ]
    },
    {
      "blocks": [
        {
          "type": "dialogue",
          "speaker": "진이현",
          "text": "그런데 당신이 웃었으니 이게 더 낫네요.",
          "portrait": "smile"
        }
      ],
      "choice": {
        "id": "aff_80_choice",
        "options": [
          {
            "id": "a",
            "text": "“그대로 둬요.”",
            "affection": 6,
            "memoryKey": "affinity_80_a",
            "response": [
              {
                "type": "dialogue",
                "speaker": "진이현",
                "text": "그러겠습니다.",
                "portrait": "smile"
