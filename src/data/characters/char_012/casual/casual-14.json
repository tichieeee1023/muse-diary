{
  "id": "char_012_casual_14",
  "kind": "casual",
  "title": "멈춘 광고판",
  "minAffection": 0,
  "maxAffection": 50,
  "defaultPortrait": "main",
  "completionAffection": 7,
  "repeatable": false,
  "placeIds": [
