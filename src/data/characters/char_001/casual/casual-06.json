{
  "id": "char_001_casual_06",
  "kind": "casual",
  "title": "돌아온 절판본",
  "minAffection": 40,
  "maxAffection": 79,
  "defaultPortrait": "hmm",
  "completionAffection": 7,
  "repeatable": true,
  "placeIds": [
