  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "분장실 벽에 삐뚤빼뚤한 크레파스 그림이 붙어 있었다."
        },
        {
          "type": "dialogue",
          "speaker": "유리안",
          "text": "저래 봬도 제일 오래된 팬아트입니다.",
          "portrait": "smile"
        },
        {
          "type": "narration",
          "text": "그림 속 유리안은 머리가 초록색이고 팔이 세 개였다."
        },
        {
          "type": "dialogue",
          "speaker": "유리안",
          "text": "정확도보다 마음이 중요하죠.",
          "portrait": "main"
        },
        {
          "type": "narration",
          "text": "그는 테이프가 떨어진 모서리를 다시 붙였다."
        }
      ]
    }
  ],
  "closing": "유리안이 가장 소중히 여기는 건 완성도가 아니었다."
}
