{
  "id": "char_005_casual_11",
  "kind": "casual",
  "title": "문이 보이는 자리",
  "minAffection": 0,
  "maxAffection": 45,
  "defaultPortrait": "main",
  "completionAffection": 7,
  "repeatable": false,
  "placeIds": [
