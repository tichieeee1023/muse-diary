{
  "id": "char_007_affinity_40",
  "kind": "story",
  "title": "현재의 김휘람",
  "threshold": 40,
  "purpose": "과거 떡밥보다 현재의 고등학생으로서 가진 욕망과 불안을 먼저 보여준다.",
  "defaultPortrait": "main",
  "completionAffection": 3,
  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "휘람은 진학 희망서를 앞에 두고 한참 펜을 움직이지 못했다."
        },
        {
          "type": "dialogue",
          "speaker": "김휘람",
          "text": "제가 뭘 좋아하는지 잘 모르겠습니다.",
          "portrait": "troubled"
        },
        {
          "type": "narration",
          "text": "과거의 기술과 기억은 많지만, 현재의 희망은 이상할 만큼 비어 있었다."
        },
        {
          "type": "dialogue",
          "speaker": "김휘람",
          "text": "잘하는 거랑 하고 싶은 건 다른 거잖아요. 이제야 그걸 알았습니다.",
          "portrait": "main"
        }
      ]
    },
    {
      "blocks": [
        {
          "type": "narration",
          "text": "그는 역사학과와 전혀 상관없는 여행 관련 학과 페이지를 오래 봤다."
        },
        {
          "type": "dialogue",
          "speaker": "김휘람",
          "text": "그냥 멀리 가보고 싶어요. 누구 지키러 가는 거 말고.",
          "portrait": "hmm"
        }
      ],
      "choice": {
        "id": "aff_40_choice",
        "options": [
          {
            "id": "a",
            "text": "“그럼 그걸 해봐요.”",
            "affection": 7,
            "response": [
              {
                "type": "dialogue",
                "speaker": "김휘람",
                "text": "그렇게 간단하게 말해도 되는 일이군요.",
                "portrait": "smile"
              }
            ],
            "memoryKey": "hwiram_40_want"
          },
          {
            "id": "b",
            "text": "“지금부터 찾아도 안 늦어요.”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "김휘람",
                "text": "…이번 생은 시간이 좀 더 있겠죠.",
                "portrait": "troubled"
              }
            ],
            "memoryKey": "hwiram_40_time"
          },
          {
            "id": "c",
            "text": "“역사 말고 좋아하는 걸 하나씩 찾아봐요.”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "김휘람",
                "text": "도와주실 겁니까?",
                "portrait": "main"
              }
            ],
            "memoryKey": "hwiram_40_find"
          }
        ]
      }
    }
  ],
  "closing": "휘람에게 필요한 건 과거의 정답이 아니라 현재의 취향이었다."
}
