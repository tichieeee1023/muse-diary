{
  "id": "char_007_casual_02",
  "kind": "casual",
  "title": "이어폰 매듭",
  "minAffection": 0,
  "maxAffection": 49,
  "defaultPortrait": "main",
  "completionAffection": 7,
  "repeatable": true,
  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "휘람이 주머니에서 꺼낸 유선 이어폰은 완벽한 매듭이 되어 있었다."
        },
        {
          "type": "dialogue",
          "speaker": "김휘람",
          "text": "이건 제가 묶은 게 아닙니다.",
          "portrait": "main"
        },
        {
          "type": "narration",
          "text": "그는 매듭을 푸는 데만 한참 걸렸다."
        },
        {
          "type": "dialogue",
          "speaker": "김휘람",
          "text": "옛날 끈은 이렇게 안 꼬였습니다.",
          "portrait": "troubled"
        },
        {
          "type": "narration",
          "text": "비교 대상이 이상했다."
        }
      ]
    }
  ],
  "closing": "현대 기계와 휘람은 아직 협상 중이었다."
}
