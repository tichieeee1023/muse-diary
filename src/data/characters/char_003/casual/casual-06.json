  "defaultPortrait": "main",
  "completionAffection": 8,
  "repeatable": false,
  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "늦은 저녁 헤어지려는데 해준이 평소처럼 말했다."
        },
        {
          "type": "dialogue",
          "speaker": "문해준",
          "text": "도착하면 연락 주세요.",
          "portrait": "main"
        },
        {
          "type": "narration",
          "text": "익숙한 말이라 대수롭지 않게 넘기자, 그가 한 박자 늦게 덧붙였다."
        },
        {
          "type": "dialogue",
          "speaker": "문해준",
          "text": "의무적으로 확인하려는 건 아닙니다.",
          "portrait": "troubled"
        },
        {
          "type": "dialogue",
          "speaker": "문해준",
          "text": "그냥…… 알면 마음이 편해서요.",
          "portrait": "main"
        },
        {
          "type": "narration",
          "text": "처음으로 그 말이 직업적인 습관만은 아니라는 걸 알았다."
        }
      ]
    }
  ],
  "closing": "같은 문장인데도 관계가 달라지면 전혀 다르게 들렸다."
}
