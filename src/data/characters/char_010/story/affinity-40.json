{
  "id": "char_010_affinity_40",
  "kind": "story",
  "title": "푸딩",
  "threshold": 40,
  "purpose": "가벼운 갭모에와 사적인 시간을 통해 관계를 인간적으로 풀어준다.",
  "defaultPortrait": "smile",
  "completionAffection": 3,
  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "경호 업무가 끝난 뒤 재하는 편의점 푸딩을 들고 옥상 계단에 앉았다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "이 시간엔 사람이 적어서 좋습니다.",
          "portrait": "main"
        },
        {
          "type": "narration",
          "text": "그는 푸딩 뚜껑을 아주 깔끔하게 뜯었다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "웃지 마십시오. 좋아하는 건 좋아하는 겁니다.",
          "portrait": "troubled"
        }
      ]
    },
    {
      "blocks": [
        {
          "type": "narration",
          "text": "한 숟갈 먹고 난 뒤, 평소보다 눈매가 아주 조금 풀렸다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "…하나 드시겠습니까.",
          "portrait": "smile"
        }
      ],
      "choice": {
        "id": "aff_40_choice",
        "options": [
          {
            "id": "a",
            "text": "“한 입만.”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "한 입 기준이 큽니다.",
                "portrait": "troubled"
              }
            ],
            "memoryKey": "jaeha_40_share"
          },
          {
            "id": "b",
            "text": "“다음엔 내가 사줄게요.”",
            "affection": 7,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "그건… 기대하겠습니다.",
                "portrait": "smile"
              }
            ],
            "memoryKey": "jaeha_40_next"
          },
          {
            "id": "c",
            "text": "“이런 취향 진짜 의외예요.”",
            "affection": 5,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "자주 듣습니다. 이해는 안 됩니다.",
                "portrait": "main"
              }
            ],
            "memoryKey": "jaeha_40_gap"
          }
        ]
      }
    }
  ],
  "closing": "재하에게도 위험과 상관없는 아주 사소한 즐거움이 있었다."
}
