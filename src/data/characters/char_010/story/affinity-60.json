{
  "id": "char_010_affinity_60",
  "kind": "story",
  "title": "빛나는 상처",
  "threshold": 60,
  "purpose": "비일상 조직과 연결된 과거를 암시하고 상처의 의미를 보여준다.",
  "defaultPortrait": "hmm",
  "completionAffection": 3,
  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "밤이 깊어지자 재하 손등의 흉터가 선명하게 빛났다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "이건 일반적인 상처가 아닙니다.",
          "portrait": "main"
        },
        {
          "type": "narration",
          "text": "그는 오래된 흉터를 가리지 않았다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "비일상 존재를 상대하던 조직에서 일했습니다. 보호와 회수가 제 일이었습니다.",
          "portrait": "hmm"
        }
      ]
    },
    {
      "blocks": [
        {
          "type": "narration",
          "text": "조직 이야기를 하는 동안 재하의 손은 계속 굳어 있었다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "좋은 조직이었다고는 말하지 않겠습니다.",
          "portrait": "troubled"
        }
      ],
      "choice": {
        "id": "aff_60_choice",
        "options": [
          {
            "id": "a",
            "text": "“그래서 그만둔 거예요?”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "네. 명령 하나를 거부했습니다.",
                "portrait": "hmm"
              }
            ],
            "memoryKey": "jaeha_60_quit"
          },
          {
            "id": "b",
            "text": "“그 흉터도 그때 생긴 거고요?”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "그렇습니다. 대가라고 생각하지는 않습니다.",
                "portrait": "main"
              }
            ],
            "memoryKey": "jaeha_60_scar"
          },
          {
            "id": "c",
            "text": "“말해줘서 고마워요.”",
            "affection": 7,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "숨기는 편이 더 위험해졌으니까요. …그 이유만은 아닙니다.",
                "portrait": "troubled"
              }
            ],
            "memoryKey": "jaeha_60_thanks"
          }
        ]
      }
    }
  ],
  "closing": "재하는 한때 훨씬 큰 위험을 다루던 사람이었다."
}
