        },
        {
          "type": "narration",
          "text": "설명도 없이 내린 결정이었다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "위험합니다. 그걸로 충분합니다.",
          "portrait": "main"
