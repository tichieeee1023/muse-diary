  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "재하는 {name}을 보자 반가움보다 주변부터 확인했다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "이 시간에 여기 오는 이유가 뭡니까.",
          "portrait": "main"
        },
        {
          "type": "narration",
          "text": "질문은 차갑고 시선은 더 차가웠다. 호의로 해석할 여지가 거의 없었다."
        }
      ]
    },
    {
      "blocks": [
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "대답하기 싫으면 돌아가셔도 됩니다.",
          "portrait": "main"
        }
      ],
      "choice": {
        "id": "aff_20_choice",
        "options": [
          {
            "id": "a",
            "text": "“그쪽이 더 수상한데요.”",
            "affection": 6,
            "memoryKey": "affinity_20_a",
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "그 반응은 정상입니다.",
                "portrait": "main"
              }
            ]
          },
          {
            "id": "b",
            "text": "“그냥 걷다가 왔어요.”",
            "affection": 4,
            "memoryKey": "affinity_20_b",
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "…알겠습니다. 그래도 오래 있진 마세요.",
                "portrait": "troubled"
              }
            ]
          },
          {
            "id": "c",
            "text": "“다음엔 안 올까요?”",
            "affection": 5,
            "memoryKey": "affinity_20_c",
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "그건 제가 정할 일이 아닙니다.",
                "portrait": "main"
              }
            ]
          }
        ]
      }
    },
    {
      "blocks": [
        {
          "type": "narration",
          "text": "그날의 경계선 밖은 이전의 만남과 조금 다른 모양으로 기억에 남았다."
        },
        {
          "type": "narration",
          "text": "재하가 주인공을 아직 신뢰하지 않는 상태 관계가 한 단계 움직였다는 걸, 굳이 숫자로 확인하지 않아도 알 수 있었다."
        }
      ]
    }
  ],
  "closing": "경계선 밖 — 중요한 관계 기록이 다이어리에 남았다."
