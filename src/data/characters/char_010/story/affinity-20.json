      ]
    },
    {
      "blocks": [
        {
          "type": "narration",
          "text": "{name}이 불쾌함을 드러내자 재하가 처음으로 조금 멈칫했다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "…제가 결정할 일이 아니라고 생각하십니까.",
          "portrait": "troubled"
        }
      ],
      "choice": {
        "id": "aff_20_choice",
        "options": [
          {
            "id": "a",
            "text": "“내 안전이어도 내 선택은 있어요.”",
            "affection": 7,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "…맞습니다. 그건 제가 넘었습니다.",
                "portrait": "main"
              }
            ],
            "memoryKey": "jaeha_20_choice"
          },
          {
            "id": "b",
            "text": "“설명하면 판단할게요.”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "권재하",
                "text": "설명할 수 있는 선까지는 하겠습니다.",
                "portrait": "hmm"
              }
            ],
            "memoryKey": "jaeha_20_explain"
          },
          {
            "id": "c",
            "text": "“이번엔 따를게요. 다음엔 말해줘요.”",
