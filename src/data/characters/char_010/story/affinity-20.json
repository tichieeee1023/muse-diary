  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "야간 골목에서 수상한 흔적을 본 {name}이 따라가려 하자 재하가 길을 막았다."
        },
        {
          "type": "dialogue",
          "speaker": "권재하",
          "text": "관여하지 마십시오.",
