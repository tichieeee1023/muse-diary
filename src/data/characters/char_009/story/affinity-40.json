{
  "id": "char_009_affinity_40",
  "kind": "story",
  "title": "제가 지금 화가 난 것 같군요",
  "threshold": 40,
  "purpose": "갭모에를 본격적으로 보여주고, 자기 감정 인식의 서툼을 관계 진전의 핵심으로 만든다.",
  "defaultPortrait": "troubled",
  "completionAffection": 3,
  "sections": [
    {
      "blocks": [
        {
          "type": "narration",
          "text": "누군가 {name}에게 무례하게 말한 뒤였다. 이겸은 평소처럼 차분했지만 찻잔을 내려놓는 소리가 조금 컸다."
        },
        {
          "type": "dialogue",
          "speaker": "차이겸",
          "text": "잠시만요.",
          "portrait": "hmm"
        },
        {
          "type": "narration",
          "text": "그는 스스로 숨을 고르고 한참 생각했다."
        },
        {
          "type": "dialogue",
          "speaker": "차이겸",
          "text": "제가 지금… 상당히 화가 난 것 같습니다.",
          "portrait": "troubled"
        }
      ]
    },
    {
      "blocks": [
        {
          "type": "narration",
          "text": "이유를 묻자 이겸이 이번에는 바로 대답했다."
        },
        {
          "type": "dialogue",
          "speaker": "차이겸",
          "text": "당신이 부당하게 취급받는 게 싫었습니다. 이건 비교적 분명하군요.",
          "portrait": "main"
        }
      ],
      "choice": {
        "id": "aff_40_choice",
        "options": [
          {
            "id": "a",
            "text": "“그럼 화내도 돼요.”",
            "affection": 7,
            "response": [
              {
                "type": "dialogue",
                "speaker": "차이겸",
                "text": "그 허가가 왜 이렇게 어렵게 들리는지 모르겠습니다.",
                "portrait": "troubled"
              }
            ],
            "memoryKey": "igyeom_40_permission"
          },
          {
            "id": "b",
            "text": "“나 때문에 화난 거네요.”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "차이겸",
                "text": "네. 정확히는 당신을 향한 게 아니라 당신 때문에.",
                "portrait": "hmm"
              }
            ],
            "memoryKey": "igyeom_40_for_you"
          },
          {
            "id": "c",
            "text": "“감정 하나 찾았네요.”",
            "affection": 6,
            "response": [
              {
                "type": "dialogue",
                "speaker": "차이겸",
                "text": "축하받을 일인지는 모르겠지만… 그렇군요.",
                "portrait": "smile"
              }
            ],
            "memoryKey": "igyeom_40_found"
          }
        ]
      }
    }
  ],
  "closing": "이겸은 처음으로 자기 감정에 이름을 붙여 누군가에게 말했다."
}
