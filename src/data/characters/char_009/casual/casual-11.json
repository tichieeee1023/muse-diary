{
  "id": "char_009_casual_11",
  "kind": "casual",
  "title": "환승 통로의 소음",
  "minAffection": 0,
  "maxAffection": 45,
  "defaultPortrait": "main",
  "completionAffection": 7,
  "repeatable": false,
  "placeIds": [
