{
  "id": "char_008_casual_12",
  "kind": "casual",
  "title": "냅킨 뒤의 선",
  "minAffection": 40,
  "maxAffection": 90,
  "defaultPortrait": "main",
  "completionAffection": 8,
  "repeatable": false,
  "placeIds": [
